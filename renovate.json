{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "gitAuthor": "Renovate Bot <renovate@whitesourcesoftware.com>",
  "commitBody": "Signed-off-by: Renovate Bot <renovate@whitesourcesoftware.com>",
  "recreateWhen": "always",
  "github-actions": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "description": "l2-runtime.yml pins a deliberately older literal mise version (EXPLICIT_MISE_VERSION); admission requires a literal, so an automated bump to latest silently breaks the differs-from-omitted-resolution invariant.",
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
